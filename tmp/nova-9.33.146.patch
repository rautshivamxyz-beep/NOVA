diff --git a/android/app/src/main/java/org/nova/ncie/android/NcieTimer.kt b/android/app/src/main/java/org/nova/ncie/android/NcieTimer.kt
new file mode 100644
index 0000000..ad8888f
--- /dev/null
+++ b/android/app/src/main/java/org/nova/ncie/android/NcieTimer.kt
@@ -0,0 +1,122 @@
+package org.nova.ncie.android
+
+/**
+ * v9.33.146 "A timer cannot crash the app": the parser behind the
+ * "timer 10 minutes" phone command.
+ *
+ * The command used to parse its own duration inline in MainActivity:
+ *
+ *     val n = m.groupValues[1].toInt()
+ *     'h' -> n * 3600
+ *
+ * with no error handling anywhere on the path - tryPhoneCommand is called
+ * straight from the chat turn. Both lines are reachable from ordinary typed
+ * text and both fail badly:
+ *
+ *  - "timer 99999999999999 minutes" -> toInt() throws NumberFormatException.
+ *    Nothing catches it, so the whole app goes down on one chat message.
+ *  - "timer 1000000 hours" -> 1000000 * 3600 overflows Int to a negative
+ *    number, so the clock app is handed a nonsense length.
+ *
+ * The arithmetic is now a pure function with no Android imports: the digits
+ * are read as a Long, the range is checked BEFORE any multiplication (every
+ * unit multiplies by at least 1, so a count already above [MAX_SECONDS] can
+ * never come back under it), and an absurd digit count that does not even
+ * fit a Long is answered the same way as any other over-long timer. Nothing
+ * here can throw, so the command can no longer crash a turn.
+ *
+ * Pure JVM, so TimerSpecTest pins it with `gradle testDebugUnitTest`.
+ */
+object NcieTimer {
+
+    /**
+     * The longest timer NOVA will set: 24 hours.
+     *
+     * A kitchen timer, not a calendar. A clock app that is handed a month of
+     * seconds either rejects it or fires in the far future with no way for
+     * the user to see what happened, and an over-long request is almost
+     * always a typo or a misheard number. Saying so is more honest than
+     * silently clamping to a value the user never asked for.
+     */
+    const val MAX_SECONDS = 86_400
+
+    /**
+     * "10 minutes", "2 hrs", "90s", "1.5 hours" - one number (with an
+     * optional fractional part) and one unit word.
+     *
+     * v9.33.146: the fraction is here because the integer-only pattern read
+     * "timer 1.5 hours" as the "5 hours" inside it and set FIVE hours - the
+     * user got a timer four and a half hours longer than the one they asked
+     * for, with a toast agreeing with the wrong number. A comma is accepted
+     * as the decimal mark too, since that is how much of the world writes it.
+     */
+    private val SPEC = Regex(
+        "(?i)(\\d+)(?:[.,](\\d+))?\\s*(hours?|hrs?|h|minutes?|mins?|m|seconds?|secs?|s)\\b")
+
+    /**
+     * A recognised duration.
+     *
+     * [tooLong] is a real answer, not a failure: the text WAS a timer request,
+     * it just asked for more than [MAX_SECONDS]. Keeping the two apart is what
+     * lets the caller tell "I did not understand that" apart from "that is too
+     * long", and answer each honestly.
+     */
+    data class Spec(val seconds: Int, val tooLong: Boolean)
+
+    /**
+     * The duration in [spec], or null when it is not a timer request at all.
+     *
+     * Never throws: an unparseable, zero-length or over-long count is a
+     * [Spec] or a null, never an exception.
+     */
+    fun parse(spec: String): Spec? {
+        val m = SPEC.find(spec) ?: return null
+        val digits = m.groupValues[1]
+        // 19 digits does not fit a Long either - still "far too long", and
+        // still an answer rather than a crash
+        val whole = digits.toLongOrNull() ?: return Spec(0, true)
+        val mult = when (m.groupValues[3].lowercase()[0]) {
+            'h' -> 3600L
+            'm' -> 60L
+            else -> 1L
+        }
+        // every unit multiplies by at least 1, so this one check makes both
+        // multiplications below overflow-free
+        if (whole > MAX_SECONDS) return Spec(0, true)
+        var secs = whole * mult
+        // the fractional part, in integer arithmetic - "1.5 hours" is 5400,
+        // not the 18000 the integer-only pattern used to read out of it
+        val frac = m.groupValues[2]
+        if (frac.isNotEmpty()) {
+            val scale = if (frac.length > 9) 9 else frac.length
+            val num = frac.substring(0, scale).toLongOrNull() ?: 0L
+            var den = 1L
+            repeat(scale) { den *= 10L }
+            secs += (num * mult + den / 2L) / den
+        }
+        if (secs > MAX_SECONDS) return Spec(0, true)
+        // "timer 0 minutes" is a timer request that asks for nothing
+        if (secs < 1L) return null
+        return Spec(secs.toInt(), false)
+    }
+
+    /**
+     * "5400" -> "1 hour 30 minutes", for the confirmation toast.
+     *
+     * The old toast echoed the user's own words back ("Timer set: 10
+     * minutes"), which is fine until the number is over-long or in a unit
+     * that hides what was set. This states what NOVA actually handed to the
+     * clock app.
+     */
+    fun label(seconds: Int): String {
+        if (seconds <= 0) return "0 seconds"
+        val h = seconds / 3600
+        val m = (seconds % 3600) / 60
+        val s = seconds % 60
+        val parts = ArrayList<String>(3)
+        if (h > 0) parts.add(h.toString() + if (h == 1) " hour" else " hours")
+        if (m > 0) parts.add(m.toString() + if (m == 1) " minute" else " minutes")
+        if (s > 0) parts.add(s.toString() + if (s == 1) " second" else " seconds")
+        return parts.joinToString(" ")
+    }
+}
diff --git a/android/app/src/test/java/org/nova/ncie/android/TimerSpecTest.kt b/android/app/src/test/java/org/nova/ncie/android/TimerSpecTest.kt
new file mode 100644
index 0000000..c0c9884
--- /dev/null
+++ b/android/app/src/test/java/org/nova/ncie/android/TimerSpecTest.kt
@@ -0,0 +1,150 @@
+package org.nova.ncie.android
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * v9.33.146: the "timer" phone command's duration parser.
+ *
+ * The two shipped bugs are the reason this test exists, so both are pinned
+ * directly: a digit run too long for an Int (which threw NumberFormatException
+ * straight out of a chat turn) and an hour count that overflowed the Int
+ * multiplication into a negative length. Neither may throw, ever - a phone
+ * command must not be able to take the app down - so every absurd input below
+ * is asserted to come back as an ordinary answer.
+ *
+ * Pure JVM, no Android imports: `gradle testDebugUnitTest`.
+ */
+class TimerSpecTest {
+
+    private fun secs(spec: String): Int? = NcieTimer.parse(spec)?.seconds
+
+    private fun tooLong(spec: String): Boolean = NcieTimer.parse(spec)?.tooLong == true
+
+    @Test
+    fun readsMinutesHoursAndSeconds() {
+        assertEquals(600, secs("10 minutes"))
+        assertEquals(600, secs("10 min"))
+        assertEquals(600, secs("10m"))
+        assertEquals(7200, secs("2 hours"))
+        assertEquals(7200, secs("2 hrs"))
+        assertEquals(7200, secs("2h"))
+        assertEquals(90, secs("90 seconds"))
+        assertEquals(90, secs("90s"))
+    }
+
+    @Test
+    fun acceptsTheSpacingAndCaseUsersActuallyType() {
+        assertEquals(600, secs("10   minutes"))
+        assertEquals(600, secs("10MINUTES"))
+        assertEquals(600, secs("Ten 10 Minutes"))
+        assertEquals(300, secs("5 m"))
+    }
+
+    @Test
+    fun aDurationThatIsNotThereIsNotATimer() {
+        assertNull(secs("ten minutes"))
+        assertNull(secs("a while"))
+        assertNull(secs("10"))
+        assertNull(secs("10 bananas"))
+        assertNull(secs(""))
+    }
+
+    /**
+     * The v9.33.146 crash: 14 digits does not fit an Int. The old inline
+     * toInt() threw NumberFormatException with no catch anywhere on the path.
+     */
+    @Test
+    fun anIntOverflowingDigitRunIsAnAnswerNotACrash() {
+        val spec = NcieTimer.parse("99999999999999 minutes")
+        assertNotNull(spec)
+        assertTrue(spec!!.tooLong)
+        assertEquals(0, spec.seconds)
+    }
+
+    /** 30 digits does not fit a Long either - still just "too long". */
+    @Test
+    fun aDigitRunTooLongForALongIsStillJustTooLong() {
+        assertTrue(tooLong("999999999999999999999999999999 hours"))
+    }
+
+    /**
+     * The v9.33.146 overflow: 1,000,000 hours is 3.6e9 seconds, which wrapped
+     * to a negative Int and was handed to the clock app as a nonsense length.
+     */
+    @Test
+    fun anHourCountThatOverflowedIntIsTooLong() {
+        assertTrue(tooLong("1000000 hours"))
+        assertTrue(tooLong("100000 hours"))
+    }
+
+    @Test
+    fun theLongestAllowedTimerIsTwentyFourHours() {
+        assertEquals(NcieTimer.MAX_SECONDS, secs("24 hours"))
+        assertEquals(NcieTimer.MAX_SECONDS, secs("1440 minutes"))
+        assertEquals(NcieTimer.MAX_SECONDS, secs("86400 seconds"))
+        assertTrue(tooLong("25 hours"))
+        assertTrue(tooLong("1441 minutes"))
+        assertTrue(tooLong("86401 seconds"))
+    }
+
+    /** "timer 0 minutes" asks for nothing - answered as a usage hint. */
+    @Test
+    fun aZeroLengthTimerIsNotATimer() {
+        assertNull(secs("0 minutes"))
+        assertNull(secs("0s"))
+    }
+
+    @Test
+    fun nothingInThisParserCanThrow() {
+        val hostile = listOf(
+            "99999999999999999999999999999999999999999999999999 h",
+            "0" + "9".repeat(400) + " minutes",
+            "-5 minutes", "+5 minutes", "5.5 hours", "1e9 seconds",
+            "\u0000", "minutes", "m")
+        for (s in hostile) {
+            // the call itself must not throw; either answer is acceptable
+            val spec = NcieTimer.parse(s)
+            if (spec != null) assertFalse("0-second spec leaked for: " + s,
+                spec.seconds == 0 && !spec.tooLong)
+        }
+    }
+
+    /**
+     * "timer 1.5 hours" used to set FIVE hours: the integer-only pattern
+     * matched the "5 hours" inside "1.5 hours", and the toast echoed it back.
+     */
+    @Test
+    fun aFractionalDurationSetsWhatTheUserAskedFor() {
+        assertEquals(5400, secs("1.5 hours"))
+        assertEquals(1800, secs("0.5 hours"))
+        assertEquals(5400, secs("1,5 hours"))
+        assertEquals(135, secs("2.25 minutes"))
+        assertEquals(30, secs("0.5 minutes"))
+        assertEquals(2, secs("1.9 seconds"))
+    }
+
+    @Test
+    fun theConfirmationSaysWhatWasActuallySet() {
+        assertEquals("10 minutes", NcieTimer.label(600))
+        assertEquals("1 minute", NcieTimer.label(60))
+        assertEquals("2 hours", NcieTimer.label(7200))
+        assertEquals("1 hour 30 minutes", NcieTimer.label(5400))
+        assertEquals("1 second", NcieTimer.label(1))
+        assertEquals("45 minutes", NcieTimer.label(45 * 60))
+        assertEquals("0 seconds", NcieTimer.label(0))
+    }
+
+    /** The study-routine timer NOVA arms itself still parses cleanly. */
+    @Test
+    fun theStudyRoutineLengthIsStillAccepted() {
+        val spec = NcieTimer.parse("45 minutes")
+        assertNotNull(spec)
+        assertEquals(45 * 60, spec!!.seconds)
+        assertFalse(spec.tooLong)
+    }
+}
