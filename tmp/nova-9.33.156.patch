From d1f843558492b3ee1b34f625fcabe211933bbe81 Mon Sep 17 00:00:00 2001
From: rautshivamxyz-beep <rautshivamxyz@gmail.com>
Date: Mon, 16 Nov 2026 03:49:22 +0000
Subject: [PATCH] v9.33.156 "One number for the suite"

Three things, one theme: a check that cannot notice its own absence is not a
check.

1. The release build was RED and it was not v9.33.155's fault. PR #113 added
   three research-gate checks to RegressionLab and bumped the expected count
   in RegressionLabTest only. SelfEvolutionEngineTest kept asserting 8 against
   a suite of 11, so "Run the unit tests" failed on every build of main and
   nothing could be released. The number now lives once, as
   RegressionLab.EXPECTED_CHECKS, and both tests read it from there: adding a
   check means bumping one constant instead of remembering two literals.

2. tmp/verify_patches.py gains the floor it never had. Deleting a check used
   to make the verifier greener, not redder - the build stayed green while the
   feature it guarded was free to leave. Every check now records itself, and
   the suite asserts it still runs at least 1004 of them, plus that no release
   block carries code with no assertion in it. A stacked header (a release
   folded into the next one) is still allowed to be empty; a block that lost
   its checks is not.

3. nova-apk.yml no longer builds for a workflow-only push. Every release is
   staged on main as a one-shot applier touching nothing but
   .github/workflows/**, and that commit started a full release build of the
   tree it was about to replace: six minutes of runner and a red run in the
   history that reads like a broken release when it is only the stale tree.
---
 .github/workflows/nova-apk.yml                |  9 ++++
 android/app/build.gradle                      |  4 +-
 .../org/nova/ncie/evaluate/RegressionLab.kt   | 13 +++++
 .../ncie/android/SelfEvolutionEngineTest.kt   |  6 ++-
 .../nova/ncie/evaluate/RegressionLabTest.kt   |  2 +-
 tmp/verify_patches.py                         | 53 +++++++++++++++++++
 6 files changed, 83 insertions(+), 4 deletions(-)

diff --git a/.github/workflows/nova-apk.yml b/.github/workflows/nova-apk.yml
index b76d56a..4f7d080 100644
--- a/.github/workflows/nova-apk.yml
+++ b/.github/workflows/nova-apk.yml
@@ -4,6 +4,15 @@ on:
   push:
     branches:
       - main
+    # v9.33.156: every release is staged on main as a one-shot applier that
+    # touches nothing but .github/workflows/**. That commit used to start a
+    # full release build of the tree it was about to replace - six minutes of
+    # runner, and a red run in the history that looks like a broken release
+    # when it is only the stale tree the applier is fixing. A push that changes
+    # no app source cannot need a release build.
+    paths-ignore:
+      - '.github/workflows/**'
+      - 'tmp/*.patch'
 concurrency:
   group: nova-apk
   cancel-in-progress: false
diff --git a/android/app/build.gradle b/android/app/build.gradle
index 4256ee7..089d544 100644
--- a/android/app/build.gradle
+++ b/android/app/build.gradle
@@ -442,8 +442,8 @@ android {
         // v9.33.147: a save that answers false is recorded, not dropped - the dead
         // try/catch left over from v9.33.90 is gone, and the nightly audit says so
         // when its report could not be saved.
-        versionCode 323
-        versionName '9.33.155'
+        versionCode 324
+        versionName '9.33.156'
         // v6.0.0: arm64 only by default. CI also builds a universal APK
         // (arm64 + x86_64, for emulators/Chromebooks) with:
         //   gradle assembleRelease -PNOVA_ABIS=arm64-v8a,x86_64
diff --git a/android/app/src/main/java/org/nova/ncie/evaluate/RegressionLab.kt b/android/app/src/main/java/org/nova/ncie/evaluate/RegressionLab.kt
index 6a41e5e..2c0ba42 100644
--- a/android/app/src/main/java/org/nova/ncie/evaluate/RegressionLab.kt
+++ b/android/app/src/main/java/org/nova/ncie/evaluate/RegressionLab.kt
@@ -14,6 +14,19 @@ import org.nova.ncie.skill.SkillStore
  * loading the language model, network, embeddings, or Android services.
  */
 object RegressionLab {
+
+    /**
+     * v9.33.156 "One number for the suite".
+     *
+     * The size of [run] used to be written out as a literal in TWO tests.
+     * PR #113 added three research-gate checks and updated one of them, so
+     * `SelfEvolutionEngineTest` kept asserting 8 against a suite of 11 and the
+     * release build went red on a test that had nothing to do with the change.
+     * The number now lives here, once: adding a check means bumping this and
+     * nothing else, and both tests read it from here.
+     */
+    const val EXPECTED_CHECKS = 11
+
     fun run(): List<Pair<String, Boolean>> = listOf(
         check("skill parse, trigger and render") {
             val skills = SkillStore.parse(
diff --git a/android/app/src/test/java/org/nova/ncie/android/SelfEvolutionEngineTest.kt b/android/app/src/test/java/org/nova/ncie/android/SelfEvolutionEngineTest.kt
index 2e002c5..8428b43 100644
--- a/android/app/src/test/java/org/nova/ncie/android/SelfEvolutionEngineTest.kt
+++ b/android/app/src/test/java/org/nova/ncie/android/SelfEvolutionEngineTest.kt
@@ -3,11 +3,15 @@ package org.nova.ncie.android
 import org.junit.Assert.assertEquals
 import org.junit.Assert.assertTrue
 import org.junit.Test
+import org.nova.ncie.evaluate.RegressionLab
 
 class SelfEvolutionEngineTest {
     @Test fun selfLearningDataChecksPass() {
         val checks = SelfEvolutionEngine.selfTests()
-        assertEquals(8, checks.size)
+        // v9.33.156: the expected size comes from RegressionLab, the one place
+        // that owns it. This test asserted a literal 8 while the suite grew to
+        // 11, and it turned the release build red for a change it never saw.
+        assertEquals(RegressionLab.EXPECTED_CHECKS, checks.size)
         assertTrue(checks.all { it.second })
     }
 
diff --git a/android/app/src/test/java/org/nova/ncie/evaluate/RegressionLabTest.kt b/android/app/src/test/java/org/nova/ncie/evaluate/RegressionLabTest.kt
index 3769e4e..ba71887 100644
--- a/android/app/src/test/java/org/nova/ncie/evaluate/RegressionLabTest.kt
+++ b/android/app/src/test/java/org/nova/ncie/evaluate/RegressionLabTest.kt
@@ -7,7 +7,7 @@ import org.junit.Test
 class RegressionLabTest {
     @Test fun deterministicLearningRegressionSuitePasses() {
         val results = RegressionLab.run()
-        assertEquals(11, results.size)
+        assertEquals(RegressionLab.EXPECTED_CHECKS, results.size)
         assertTrue(results.filterNot { it.second }.joinToString { it.first }.let { it.isEmpty() })
     }
 }
diff --git a/tmp/verify_patches.py b/tmp/verify_patches.py
index a66b782..0e5d356 100644
--- a/tmp/verify_patches.py
+++ b/tmp/verify_patches.py
@@ -29,7 +29,15 @@ FILES = ["MainActivity.kt", "KnowledgeActivity.kt"]
 
 fails = []
 
+# v9.33.156: every check that runs is also counted. The suite is the only
+# thing standing between a refactor and a silent feature loss, and until now
+# nothing noticed when a block quietly disappeared from this file - only when
+# one of the remaining assertions went stale. A floor turns a deleted block
+# into a red build instead of a quieter, greener one.
+_ran = []
+
 def check(name, cond):
+    _ran.append(name)
     print(("PASS  " if cond else "FAIL  ") + name)
     if not cond:
         fails.append(name)
@@ -3142,6 +3150,51 @@ check("v9.33.155: the shared gate is pinned by unit tests",
 check("v9.33.155: version is at least 9.33.155 (323)",
       version_at_least("9.33.155", 323))
 
+# ---- v9.33.156 "The verifier cannot shrink" ----
+# A check that is deleted is worse than a check that fails: the build stays
+# green while the feature it guarded is free to leave. Two floors fix that -
+# the total number of checks, and one check in every release block.
+_FLOOR = 1004
+check("v9.33.156: the whole check suite still runs (>= %d checks)" % _FLOOR,
+      len(_ran) >= _FLOOR)
+_src = open(os.path.join(ROOT, "tmp/verify_patches.py"), encoding="utf-8").read()
+_missing = []
+for _m in re.finditer(r"^# ---- (v[0-9][^\s]*).*$", _src, re.M):
+    _tail = _src[_m.end():_m.end() + 2400]
+    _nxt = re.search(r"^# ---- ", _tail, re.M)
+    if _nxt:
+        _tail = _tail[:_nxt.start()]
+    # A stacked header (a release whose line was folded into the next one) is
+    # allowed to hold no check of its own: only a block that carries code and
+    # still asserts nothing is a hole.
+    _code = "\n".join(_l for _l in _tail.split("\n")
+                      if _l.strip() and not _l.strip().startswith("#"))
+    if _code and "check(" not in _code:
+        _missing.append(_m.group(1))
+check("v9.33.156: every release block still carries a check"
+      + ("" if not _missing else " (empty: %s)" % ", ".join(_missing)),
+      not _missing)
+check("v9.33.156: version is at least 9.33.156 (324)",
+      version_at_least("9.33.156", 324))
+# The regression suite's size is owned in ONE place. PR #113 added three checks
+# and bumped the literal in RegressionLabTest only, so SelfEvolutionEngineTest
+# kept asserting 8 against a suite of 11 and the release build went red.
+_rlab = load("ncie/evaluate/RegressionLab.kt")
+check("v9.33.156: the regression suite size has one home (RegressionLab)",
+      _rlab.count("const val EXPECTED_CHECKS = ") == 1 and
+      "RegressionLab.EXPECTED_CHECKS" in load_test("evaluate/RegressionLabTest.kt") and
+      "RegressionLab.EXPECTED_CHECKS" in load_test("android/SelfEvolutionEngineTest.kt"))
+check("v9.33.156: no test pins the regression suite to a literal size",
+      not re.search(r"assertEquals\(\s*\d+\s*,\s*(checks|results)\.size\s*\)",
+                    load_test("evaluate/RegressionLabTest.kt") +
+                    load_test("android/SelfEvolutionEngineTest.kt")))
+# A staging commit that touches only .github/workflows/** used to start a full
+# release build of the tree it was about to replace.
+_apk = open(os.path.join(ROOT, ".github/workflows/nova-apk.yml"), encoding="utf-8").read()
+check("v9.33.156: a workflow-only push does not start a release build",
+      "paths-ignore:" in _apk and "'.github/workflows/**'" in _apk and
+      _apk.count("workflow_dispatch:") == 1)
+
 print("")
 if fails:
     print("VERIFY FAILED: %d problem(s)" % len(fails))
-- 
