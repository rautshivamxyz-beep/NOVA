From 2784a8bc8808f6ea62a7d1960c59329730917b0e Mon Sep 17 00:00:00 2001
From: rautshivamxyz-beep <rautshivamxyz@gmail.com>
Date: Sat, 14 Nov 2026 03:49:17 +0000
Subject: [PATCH] v9.33.149 "The reply is saved, or it says so"

v9.33.148 gave the conversation save an answer. The save that actually
decides whether a turn survives was not asking for it: the persist at the end
of every reply called ChatStore.save and threw the Boolean away, so a full
disk or a storage fault lost the whole conversation while the reply sat on
screen looking saved. That is the one file in NOVA the user cannot re-type,
and it was the last silent save left in the chat screen.

Its catch was wrong in a second way. It caught every Exception, including
CancellationException, so a turn the user had cancelled - or one cancelled by
switching chats - carried on as though the work had finished: it went on to
the chat-identity re-check, the speech flush and the continuation decision
with nothing left to do them for. Cancellation is rethrown now and only a
real failure is answered with false.

The warning is said once per session, not once per reply. A disk that is full
is full on every turn, and a toast after every answer would be worse than the
problem it reports. MainActivity keeps one flag and one helper, and the
wording comes from the pure ChatStore.saveNotice the last release added.

Two more catches in the same file could never run at all - they wrapped bare
ChatStore.save calls, which answer false instead of throwing since v9.33.90 -
so they are gone, and the failure is still recorded by writeOrNote.

Five verify checks hold it. The rest of the chat engine's dead catches are
counted in the plan as the next audit item rather than swept in here.
---
 android/app/build.gradle                      |  4 +-
 .../src/main/java/org/nova/MainActivity.kt    | 38 +++++++++++++++++--
 tmp/verify_patches.py                         | 22 +++++++++++
 3 files changed, 58 insertions(+), 6 deletions(-)

diff --git a/android/app/build.gradle b/android/app/build.gradle
index 777c738..1ad1835 100644
--- a/android/app/build.gradle
+++ b/android/app/build.gradle
@@ -442,8 +442,8 @@ android {
         // v9.33.147: a save that answers false is recorded, not dropped - the dead
         // try/catch left over from v9.33.90 is gone, and the nightly audit says so
         // when its report could not be saved.
-        versionCode 316
-        versionName '9.33.148'
+        versionCode 317
+        versionName '9.33.149'
         // v6.0.0: arm64 only by default. CI also builds a universal APK
         // (arm64 + x86_64, for emulators/Chromebooks) with:
         //   gradle assembleRelease -PNOVA_ABIS=arm64-v8a,x86_64
diff --git a/android/app/src/main/java/org/nova/MainActivity.kt b/android/app/src/main/java/org/nova/MainActivity.kt
index 6af826e..cd7664a 100644
--- a/android/app/src/main/java/org/nova/MainActivity.kt
+++ b/android/app/src/main/java/org/nova/MainActivity.kt
@@ -153,6 +153,18 @@ class MainActivity : Activity() {
     internal var pendingCards = false
     private var pendingAutosend: String? = null
 
+    /** v9.33.149: the "could not save this chat" warning is said once per
+     *  session. A disk that is full is full on every turn, and a toast after
+     *  every single reply would be worse than the problem it reports. */
+    private var warnedUnsavedChat = false
+
+    /** v9.33.149: say, once, that the conversation did not reach the disk. */
+    private fun warnChatNotSaved() {
+        if (warnedUnsavedChat) return
+        warnedUnsavedChat = true
+        toast(ChatStore.saveNotice(false) ?: "Could not save this chat to the phone")
+    }
+
     /** Compressed summary of older turns (auto-compact). */
     internal var compactSummary: String? = null
     internal var compacting = false
@@ -1344,7 +1356,11 @@ class MainActivity : Activity() {
             // still runs (it also stores the answer); this one is the
             // parachute.
             scope.launch(Dispatchers.IO) {
-                try { ChatStore.save(this@MainActivity, genChat) } catch (e: Exception) { NovaLog.quiet("MainActivity", e) }
+                // v9.33.149: the catch here could never run - ChatStore.save
+                // answers false instead of throwing (v9.33.90/v9.33.148) - and
+                // it was dead code of exactly the kind v9.33.147 removed from
+                // six other files. The answer is recorded by writeOrNote.
+                ChatStore.save(this@MainActivity, genChat)
             }
         }
         val replyMsg: Msg
@@ -1635,9 +1651,22 @@ class MainActivity : Activity() {
                             }
                     }
                     // persist the conversation
-                    try {
+                    // v9.33.149 "The reply is saved, or it says so": this is
+                    // the save that decides whether the turn the user is
+                    // looking at survives the app. It threw its answer away,
+                    // so a full disk lost the whole conversation while the
+                    // reply sat on screen looking saved. It also caught every
+                    // Exception - including CancellationException - so a
+                    // cancelled turn carried on as if the work had finished.
+                    val turnSaved = try {
                         withContext(Dispatchers.IO) { ChatStore.save(this@MainActivity, genChat) }
-                    } catch (e: Exception) { NovaLog.quiet("MainActivity", e) }
+                    } catch (e: CancellationException) {
+                        throw e
+                    } catch (e: Exception) {
+                        NovaLog.quiet("MainActivity", e)
+                        false
+                    }
+                    if (!turnSaved) warnChatNotSaved()
                     // v7.6: the save above SUSPENDS the Main thread - the
                     // user can switch chats during it. Re-check before
                     // continuing/compacting, or the continuation lands in
@@ -2692,7 +2721,8 @@ class MainActivity : Activity() {
         currentChat.messages.add(reply); adapter.add(reply)
         scrollToEnd()
         scope.launch(Dispatchers.IO) {
-            try { ChatStore.save(this@MainActivity, currentChat) } catch (e: Exception) { NovaLog.quiet("MainActivity", e) }
+            // v9.33.149: same dead catch as above - the save answers, never throws.
+            ChatStore.save(this@MainActivity, currentChat)
         }
         return true
     }
diff --git a/tmp/verify_patches.py b/tmp/verify_patches.py
index ca6a9b0..25428dd 100644
--- a/tmp/verify_patches.py
+++ b/tmp/verify_patches.py
@@ -2911,6 +2911,28 @@ check("v9.33.148: version is at least 9.33.148 (316)",
       version_at_least("9.33.148", 316))
 structural("ChatStore.kt", _chatstore)
 
+# v9.33.149 "The reply is saved, or it says so": v9.33.148 gave the
+# conversation save an answer, but the save that actually decides whether a
+# turn survives - the one at the end of every reply - still threw it away, and
+# its catch swallowed CancellationException too. It asks now, and says so once
+# per session. The two parachute saves lose a catch that could never run.
+_main = _src("MainActivity.kt")
+check("v9.33.149: the turn-end save asks for its answer",
+      'val turnSaved = try {' in _main and
+      'if (!turnSaved) warnChatNotSaved()' in _main)
+check("v9.33.149: a cancelled turn is not swallowed by the save",
+      'catch (e: CancellationException) {' in _main and
+      'throw e' in _main)
+check("v9.33.149: the warning is said once, not after every reply",
+      'private var warnedUnsavedChat = false' in _main and
+      'if (warnedUnsavedChat) return' in _main and
+      'ChatStore.saveNotice(false)' in _main)
+check("v9.33.149: no dead catch is left around a conversation save in the chat screen",
+      'try { ChatStore.save' not in _main)
+check("v9.33.149: version is at least 9.33.149 (317)",
+      version_at_least("9.33.149", 317))
+structural("MainActivity.kt", _main)
+
 print("")
 if fails:
     print("VERIFY FAILED: %d problem(s)" % len(fails))
