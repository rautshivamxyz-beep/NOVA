+                if (sb.isEmpty()) { x0 = px0; x1 = px1; y = p.yDirAdj }
+                else if (px1 > x1) x1 = px1
+                sb.append(u)
+            }
+            if (sb.isNotEmpty()) words.add(WordW(x0, x1, y, sb.toString()))
+        }
