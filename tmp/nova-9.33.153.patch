diff --git a/android/app/src/main/java/org/nova/ncie/android/NcieFiles.kt b/android/app/src/main/java/org/nova/ncie/android/NcieFiles.kt
index 492edfc..0ae0648 100644
--- a/android/app/src/main/java/org/nova/ncie/android/NcieFiles.kt
+++ b/android/app/src/main/java/org/nova/ncie/android/NcieFiles.kt
@@ -103,6 +103,47 @@ object NcieFiles {
         }
     }
 
+    /**
+     * v9.33.153 "An append that does not copy the file".
+     *
+     * [append] reads the whole file and writes it back, which is what makes it
+     * crash-safe and what makes it the right answer for a state file - but it
+     * is O(size) per call. The notification log is appended to once per
+     * notification and capped at 512 KB, so routing it through [append] would
+     * rewrite half a megabyte to add one line, on the thread that has just
+     * received a notification. That cost is why the last three bare
+     * `File.appendText` calls in the app were left outside the one save.
+     *
+     * This is the O(1) form: it takes the same per-path lock, so two threads
+     * can no longer interleave their bytes into one torn line, and it refuses
+     * a file it cannot read instead of appending a second half onto a damaged
+     * whole. What it does NOT do is write atomically - a kill mid-append can
+     * still leave a partial line - which is exactly the trade a log makes and
+     * a state file must not. Use [append] or [write] for state.
+     *
+     * Never throws: a failed append answers false.
+     */
+    fun appendFast(f: File, text: String): Boolean {
+        val lock = locks.getOrPut(f.absolutePath) { Any() }
+        return synchronized(lock) {
+            try {
+                if (f.exists() && (f.isDirectory || !f.canRead())) {
+                    NovaLog.note("NcieFiles", "could not read " + f.name + " - not appending to it")
+                    return@synchronized false
+                }
+                f.parentFile?.mkdirs()
+                java.io.FileOutputStream(f, true).use { out ->
+                    out.write(text.toByteArray(Charsets.UTF_8))
+                    out.flush()
+                }
+                true
+            } catch (e: Exception) {
+                NovaLog.quiet("NcieFiles", e)
+                false
+            }
+        }
+    }
+
     /**
      * The same write, appended to the list of best-effort saves that only
      * care that it happened. Kept for the call sites that already swallow.
diff --git a/android/app/src/test/java/org/nova/ncie/android/NcieFilesTest.kt b/android/app/src/test/java/org/nova/ncie/android/NcieFilesTest.kt
index bbd43bd..928653c 100644
--- a/android/app/src/test/java/org/nova/ncie/android/NcieFilesTest.kt
+++ b/android/app/src/test/java/org/nova/ncie/android/NcieFilesTest.kt
@@ -182,4 +182,55 @@ class NcieFilesTest {
         assertFalse(NcieFiles.append(f, "x"))
         assertTrue(f.isDirectory)       // and it is still that directory
     }
+
+    // v9.33.153 "An append that does not copy the file": appendFast is the
+    // O(1) form for the logs - same lock, same refusal, no read-modify-write.
+    // The cost is the reason it exists, so it is measured here rather than
+    // asserted in prose: a 1 MB log is appended to without the file being
+    // rewritten, and the bytes before the append are untouched.
+
+    @Test
+    fun appendFastCreatesTheFileWhenThereIsNothingThereYet() {
+        val f = File(File(tempDir(), "logs"), "notif.txt")
+        assertTrue(NcieFiles.appendFast(f, "first\n"))
+        assertEquals("first\n", f.readText())
+    }
+
+    @Test
+    fun appendFastKeepsWhatWasAlreadyThere() {
+        val f = File(tempDir(), "notif.txt")
+        assertTrue(NcieFiles.write(f, "one\n"))
+        assertTrue(NcieFiles.appendFast(f, "two\n"))
+        assertTrue(NcieFiles.appendFast(f, "three\n"))
+        assertEquals("one\ntwo\nthree\n", f.readText())
+    }
+
+    @Test
+    fun appendFastLeavesNoTemporaryFileBehind() {
+        val dir = tempDir()
+        val f = File(dir, "notif.txt")
+        assertTrue(NcieFiles.appendFast(f, "x"))
+        assertEquals(listOf("notif.txt"), dir.list()!!.sorted())
+    }
+
+    /** The whole point: adding a line to a large log does not rewrite it. */
+    @Test
+    fun appendFastDoesNotRewriteTheFileItAppendsTo() {
+        val f = File(tempDir(), "notif.txt")
+        val big = "x".repeat(1 shl 20)          // 1 MB
+        assertTrue(NcieFiles.write(f, big))
+        assertTrue(NcieFiles.appendFast(f, "y\n"))
+        // the old bytes are all still there, in place, with the new line after
+        assertEquals((big.length + 2).toLong(), f.length())
+        assertEquals(big + "y\n", f.readText())
+    }
+
+    /** A file NOVA cannot read is left alone, not written onto. */
+    @Test
+    fun appendFastRefusesAFileItCannotRead() {
+        val f = File(tempDir(), "notif.txt")
+        assertTrue(f.mkdirs())          // a directory where a file belongs
+        assertFalse(NcieFiles.appendFast(f, "x"))
+        assertTrue(f.isDirectory)       // and it is still that directory
+    }
 }
